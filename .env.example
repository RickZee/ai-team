# ai-team environment template
# Copy to .env and fill in keys for the backend(s) you use.
# Full variable list: README.md → Configuration reference
# Models / tiers: docs/MODELS.md  |  Guardrails: docs/GUARDRAILS.md

# =============================================================================
# REQUIRED (pick the key for your --backend)
# =============================================================================
# CrewAI / LangGraph — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Claude Agent SDK — Anthropic console (not OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Model tier for OpenRouter backends: dev | test | prod
AI_TEAM_ENV=dev

# =============================================================================
# COMMON OVERRIDES (defaults are fine for most local runs)
# =============================================================================
# AI_TEAM_MAX_COST_PER_RUN=5.00   # Pre-run estimate ceiling (USD); abort if estimate exceeds
# AI_TEAM_RUN_BUDGET_USD=5.0      # Runtime spend kill (USD); 0 disables; default 5.0
# PROJECT_PLANNING_SEQUENTIAL=1   # Sequential planning crew (no PO tools)
# CREWAI_HARD_TIMEOUT_SECONDS=900 # CrewAI subprocess wall-clock kill
# AI_TEAM_LANGGRAPH_GRAPH_MODE=full  # placeholder (CLI default) | full
# AI_TEAM_USE_REAL_LLM=1          # Live OpenRouter in integration/evals
# AI_TEAM_TEST_MEMORY=1           # Live memory/embedder integration tests
# AI_TEAM_EVAL_BUDGET_USD=5.00    # Live eval suite hard ceiling (Tier B/C); Tier A is $0
